# ─────────────────────────────────────────────────────────────────────────────
#  Doc Ledger — environment
#
#  Copy to .env for local development. In production every one of these is set
#  in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres connection string.
# Vercel → Storage → Neon → "Connection string" (use the pooled one).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob read/write token — where uploaded receipts are stored.
# Vercel → Storage → Blob → the store's ".env.local" tab.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Claude API key — used for receipt extraction (claude-sonnet-4-6, vision + PDF).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ── Optional ────────────────────────────────────────────────────────────────
# Creates a single owner account for org 1 the first time `npm run db:seed`
# (or `npm run db:migrate`) runs. Leave blank to skip.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Local dev only — the port server/dev.js listens on. Ignored on Vercel.
PORT=3001
