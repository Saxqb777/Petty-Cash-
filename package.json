{
  "name": "doc-ledger",
  "version": "2.0.0",
  "private": true,
  "description": "Doc Ledger — receipt capture, AI extraction and expense reporting (Vercel + Neon + Vercel Blob)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/dev.js",
    "dev:client": "cd client && npm run dev",
    "start": "node server/dev.js",
    "build": "cd client && npm install && npm run build",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^8.2.0",
    "multer": "^2.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
